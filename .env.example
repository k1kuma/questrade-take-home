# Copy to .env.local (git-ignored). Every variable is optional.

# CoinGecko demo key, sent as x-cg-demo-api-key. Leave empty to use the keyless public tier.
COINGECKO_API_KEY=

# PORT=3000
# DB_PATH=data/portfolio.db
# How old a fiat rate may be before it's no longer used as a fallback.
# FIAT_MAX_STALE_DAYS=7

# Valuation snapshots older than this are deleted (checked hourly).
# HISTORY_RETENTION_DAYS=90

# Demo only: make every CoinGecko call fail with a 429 or a timeout.
# SIMULATE_COINGECKO=429
